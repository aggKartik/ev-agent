{
  "name": "ev-agent",
  "private": true,
  "packageManager": "bun@1.2.21",
  "type": "module",
  "imports": {
    "#/styled-system/*": "./styled-system/*",
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "prepare": "bunx panda codegen",
    "build": "bun run prepare && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun --bun .output/server/index.mjs",
    "db:start": "docker compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "bun run src/server/platform/db/migrate.ts",
    "db:migrate:reset": "bun run src/server/platform/db/migrate-rollback-all.ts",
    "smoke:tools": "bun --env-file=.env run scripts/smoke/plan-tools/main.ts",
    "tesla:register-partner": "bun --env-file=.env run scripts/tesla/register-partner.ts",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "lint:complexity": "bun run scripts/lint/fallow-complexity.ts",
    "check": "biome check && bun run lint:complexity"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/provider-utils": "^4.0.26",
    "@ark-ui/react": "^5.35.0",
    "@clerk/tanstack-react-start": "^1.1.3",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mapbox/polyline": "^1.2.1",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "ai": "^6.0.174",
    "jsonrepair": "^3.14.0",
    "kysely": "^0.28.15",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.545.0",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@pandacss/dev": "^1.9.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "fallow": "^2.63.0",
    "jsdom": "^28.1.0",
    "nitro": "^3.0.260311-beta",
    "postcss": "^8.5.8",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}

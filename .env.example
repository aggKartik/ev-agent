# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_agent

# API Keys (example)
# API_KEY=your-api-key-here

# Clerk (https://dashboard.clerk.com → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Where our custom sign-in / sign-up pages live — keep these aligned with the
# routes under src/routes/sign-in/ and src/routes/sign-up/.
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
# After authenticating, always land users inside the onboarding flow.
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/onboarding
CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Add your environment variables here

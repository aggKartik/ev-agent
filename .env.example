# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_agent

# API Keys (example)
# API_KEY=your-api-key-here

# Clerk (https://dashboard.clerk.com → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Where our custom sign-in / sign-up pages live — keep these aligned with the
# routes under src/routes/sign-in/ and src/routes/sign-up/.
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
# After authenticating, always land users inside the onboarding flow.
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/onboarding
CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Local / CI test user. Any address containing `+clerk_test` is a Clerk
# "test email" on development instances: no real email is sent and the
# sign-in code is always `424242`. Setting this surfaces a DEV-only prefill
# + hint on the sign-in/sign-up forms so humans and AI agents can log in
# without Google OAuth. Leave unset (or blank) to hide the hint.
# See: https://clerk.com/docs/guides/development/testing/test-emails-and-phones
VITE_TEST_USER_EMAIL=devin+clerk_test@ev-agent.test

# Shared OAuth config (applies to every provider integration).
# Public base URL of this app; used to derive each provider's callback as
# `${OAUTH_BASE_URL}/api/oauth/{slug}/callback`. In production this must
# match a redirect URI configured on the provider's developer dashboard.
OAUTH_BASE_URL=http://localhost:3000
# 32-byte key used to AES-256-GCM encrypt every provider's access + refresh
# tokens at rest. Generate with: `openssl rand -base64 32`. Rotating this
# value invalidates every stored OAuth token; plan a re-connect flow before
# rotating in production.
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Tesla Fleet API (partner-level developer application; see
# docs/tesla-fleet-api.md for provisioning). Credentials come from
# developer.tesla.com → Applications. Never commit real values.
TESLA_CLIENT_ID=replace_me
TESLA_CLIENT_SECRET=replace_me
# "na" or "eu" — selects the Fleet API region base URL used as the OAuth
# audience and for subsequent Fleet API calls.
TESLA_REGION=na

# Trip planner: any OpenAI-compatible HTTP API (OpenAI, OpenRouter, Azure OpenAI, etc.).
# Defaults target OpenRouter's free `openai/gpt-oss-120b:free` tier.
OPENAI_API_KEY=sk-or-replace_me
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-120b:free
# For api.openai.com instead, set OPENAI_BASE_URL=https://api.openai.com/v1 and OPENAI_MODEL to the model id from the OpenAI docs.
# Mapbox token for places + directions tools (https://account.mapbox.com/).
MAPBOX_TOKEN=pk.replace_me
# TomTom Long Distance EV Routing (prefetch corridor + charger waypoints): https://developer.tomtom.com/
TOMTOM_API_KEY=
# OpenChargeMap API key (https://openchargemap.org/site/develop/api). Optional but recommended.
OPENCHARGEMAP_KEY=replace_me

# Add your environment variables here

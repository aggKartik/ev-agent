# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_agent

# API Keys (example)
# API_KEY=your-api-key-here

# Clerk (https://dashboard.clerk.com → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Where our custom sign-in / sign-up pages live — keep these aligned with the
# routes under src/routes/sign-in/ and src/routes/sign-up/.
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
# After authenticating, always land users inside the onboarding flow.
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/onboarding
CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Test-user auth (see docs/testing-auth.md).
# When enabled, the /sign-in and /sign-up pages show a "Continue as test
# user" button that uses Clerk's test-mode `+clerk_test` subaddress and the
# universal verification code `424242`. No Google, no real email — ideal for
# local dev and AI agents. Defaults to enabled in dev builds; set to `false`
# to force-hide, or `true` to expose it in preview/prod-like builds. Clerk's
# test mode must also be enabled on the instance (the default for dev
# instances).
VITE_ENABLE_TEST_USER=true

# Shared OAuth config (applies to every provider integration).
# Public base URL of this app; used to derive each provider's callback as
# `${OAUTH_BASE_URL}/api/oauth/{slug}/callback`. In production this must
# match a redirect URI configured on the provider's developer dashboard.
OAUTH_BASE_URL=http://localhost:3000
# 32-byte key used to AES-256-GCM encrypt every provider's access + refresh
# tokens at rest. Generate with: `openssl rand -base64 32`. Rotating this
# value invalidates every stored OAuth token; plan a re-connect flow before
# rotating in production.
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Tesla Fleet API (partner-level developer application; see
# docs/tesla-fleet-api.md for provisioning). Credentials come from
# developer.tesla.com → Applications. Never commit real values.
TESLA_CLIENT_ID=replace_me
TESLA_CLIENT_SECRET=replace_me
# "na" or "eu" — selects the Fleet API region base URL used as the OAuth
# audience and for subsequent Fleet API calls.
TESLA_REGION=na

# Add your environment variables here
